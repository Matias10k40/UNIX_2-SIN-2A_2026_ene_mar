# List all files, including hidden ones
ls -a 
# List all files, including hidden ones (long option)
ls --all
# List all files with details, hidden files, and human-readable sizes
ls -l -a -h 
# List all files with details and hidden files (short form)
ls -l -ah 
# List all files with details and hidden files (compact form)
ls -lah 
# Create a directory named "-rf" by ending option parsing with --
mkdir -- -rf
# Remove the directory named "-rf" by ending option parsing with --
rmdir -- -rf
# Show help information for the ls command
ls --help
# Display the manual page for ls
man ls 
